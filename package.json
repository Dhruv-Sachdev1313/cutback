{
  "name": "cutback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked video that changes its argument when the facts change.",
  "scripts": {
    "dev": "concurrently -k -n api,studio 'tsx watch server/index.ts' 'vite --host 127.0.0.1 --port 4317'",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "db:up": "docker compose up -d falkordb",
    "db:stop": "docker compose stop falkordb",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "format": "prettier --write src server shared tests scripts package.json tsconfig.json vite.config.ts compose.yaml README.md docs",
    "mcp": "node --import tsx server/mcp.ts",
    "upload:build": "tsc --noEmit && vite build --config vite.upload.config.ts",
    "upload:start": "node --import tsx server/upload/index.ts",
    "upload:db": "docker compose -f compose.upload.yaml up -d",
    "upload:setup-transcription": "uv venv --python 3.11 .venv && uv pip install --python .venv/bin/python -r requirements-transcription.txt",
    "test:upload": "node --import tsx --test tests/upload*.test.ts",
    "test:upload-integration": "node --import tsx --test tests/integration/upload.test.ts",
    "test:upload-browser": "node scripts/check-upload.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "falkordb": "6.8.0",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "^3.1.0",
    "jose": "^6.2.12",
    "lucide-react": "0.468.0",
    "openai": "7.38.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/express": "5.0.3",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "concurrently": "9.2.5",
    "prettier": "^3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
