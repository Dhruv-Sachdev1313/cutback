{
  "name": "cutback", "version": "0.1.0", "private": true, "type": "module",
  "description": "Evidence-linked video that changes its argument when the facts change.",
  "scripts": {
    "dev": "concurrently -k -n api,studio 'tsx watch server/index.ts' 'vite --host 127.0.0.1 --port 4317'",
    "build": "tsc --noEmit && vite build", "start": "tsx server/index.ts",
    "db:up": "docker compose up -d falkordb", "db:stop": "docker compose stop falkordb",
    "test": "tsx --test tests/*.test.ts", "test:integration": "tsx --test tests/integration/*.test.ts",
    "mcp": "tsx server/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.3", "dotenv": "16.6.1", "express": "5.1.0",
    "falkordb": "6.8.0", "ffmpeg-static": "5.2.0", "lucide-react": "0.468.0", "openai": "latest",
    "react": "19.1.1", "react-dom": "19.1.1", "sharp": "0.34.3", "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3", "@types/node": "22.18.0", "@types/react": "19.1.10", "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2", "concurrently": "9.2.1", "tsx": "4.20.5", "typescript": "5.9.2", "vite": "7.1.3"
  },
  "engines": { "node": ">=22.12.0" }
}
