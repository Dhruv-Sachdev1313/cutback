# Copy to .env. Never commit API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# auto uses OpenAI when configured; otherwise explicitly labelled local rules.
# openai requires a key and fails visibly instead of silently falling back.
AGENT_MODE=auto
# local = macOS say / Linux espeak-ng; openai = OpenAI speech API.
TTS_PROVIDER=local
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6387
FALKORDB_GRAPH=cutback
PORT=4318
